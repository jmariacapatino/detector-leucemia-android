<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    tools:context=".MainActivity">

    <!-- Visor de cámara en tiempo real -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/overlayPanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:scaleType="fillCenter" />

    <!-- Visor de imagen estática (Muestras C-NMC 2019 o Galería) -->
    <ImageView
        android:id="@+id/ivStaticPreview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#FF0A0A0A"
        android:scaleType="fitCenter"
        android:visibility="gone"
        android:contentDescription="Vista de célula C-NMC 2019"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/overlayPanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Etiqueta superior con información de la muestra actual -->
    <TextView
        android:id="@+id/tvSampleInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:background="#CC111827"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:text="Modo Cámara en Vivo (Tiempo Real)"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Panel inferior de control y resultados -->
    <LinearLayout
        android:id="@+id/overlayPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_overlay_panel"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Fila superior: Selector de Paradigma (VI) + Estado del modelo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnToggleParadigm"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="VI: MODO LOCAL (TFLite INT8)"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#1E40AF"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tvModelStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/model_pending"
                android:textSize="10.5sp"
                android:textColor="@color/colorBlastoDetected"
                android:textStyle="bold"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:background="@drawable/bg_status_badge" />
        </LinearLayout>

        <!-- Botones de Fuente de Entrada: Muestra C-NMC 2019 | Galería | Cámara en Vivo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <Button
                android:id="@+id/btnNextCnmcSample"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1.25"
                android:text="Muestra C-NMC"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#047857"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="2dp"
                android:layout_marginEnd="5dp" />

            <Button
                android:id="@+id/btnPickGallery"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="0.9"
                android:text="Galería"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#374151"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="2dp"
                android:layout_marginEnd="5dp" />

            <Button
                android:id="@+id/btnLiveCamera"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="0.9"
                android:text="Cámara"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#4B5563"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="2dp" />
        </LinearLayout>

        <!-- Resultado principal de diagnóstico -->
        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/waiting_model"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/colorTextSecondary"
            android:gravity="center"
            android:letterSpacing="0.03"
            android:layout_marginBottom="10dp"
            tools:text="LEUCOCITO NORMAL" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33FFFFFF"
            android:layout_marginBottom="10dp" />

        <!-- Barra de probabilidad: ALL (blasto) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="3dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/label_all"
                android:textSize="11.5sp"
                android:textColor="@color/colorBlastoDetected"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAllLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11.5sp"
                android:textColor="@color/colorTextSecondary"
                tools:text="97.8%" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressAll"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="9dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/colorBlastoDetected"
            android:progressBackgroundTint="#33FF4444"
            android:layout_marginBottom="8dp" />

        <!-- Barra de probabilidad: HEM (normal) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="3dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/label_hem"
                android:textSize="11.5sp"
                android:textColor="@color/colorNormal"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHemLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11.5sp"
                android:textColor="@color/colorTextSecondary"
                tools:text="2.2%" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressHem"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="9dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/colorNormal"
            android:progressBackgroundTint="#3300C853"
            android:layout_marginBottom="10dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33FFFFFF"
            android:layout_marginBottom="8dp" />

        <!-- Los 4 indicadores del Instrumento 2 (Matriz de registro de rendimiento técnico) -->
        <TextView
            android:id="@+id/tvLatencyTemp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/latency_temp_default"
            android:textSize="11.5sp"
            android:textColor="@color/colorTextSecondary"
            android:gravity="center"
            tools:text="Lat: 58ms | RAM: 84.2MB | Temp: 36.5°C | CPU: 1800MHz" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
