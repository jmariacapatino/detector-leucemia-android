<?xml version="1.0" encoding="utf-8"?>
<!--
    Fondo del panel de resultados inferior.
    Esquinas superiores redondeadas con radio 24dp.
    Color: negro semitransparente (80% opacidad).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="@color/colorOverlay" />

    <corners
        android:topLeftRadius="24dp"
        android:topRightRadius="24dp"
        android:bottomLeftRadius="0dp"
        android:bottomRightRadius="0dp" />

    <stroke
        android:width="1dp"
        android:color="@color/colorOverlayBorder" />

</shape>
